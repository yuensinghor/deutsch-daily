{
  "expo": {
    "name": "Deutsch Daily",
    "slug": "deutsch-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.deutschdaily.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used to check how you say the German sentence.",
          "speechRecognitionPermission": "Used to check how you say the German sentence.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f9d308f8-1c21-430d-942f-4cf1f7004b11"
      }
    }
  }
}
